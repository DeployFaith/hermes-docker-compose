# Hermes Agent Docker Compose - Environment Variables
# Copy this file to .env and edit as needed.

# Host path for persistent hermes data (default: ~/.hermes)
# HERMES_DATA_DIR=~/.hermes

# Host port for the gateway API (default: 8642)
# GATEWAY_PORT=8642

# Host port for the dashboard UI (default: 9120)
# DASHBOARD_PORT=9120
